{
  "type": "module",
  "name": "cockpit-compose",
  "version": "1.0.0-alpha",
  "description": "Docker Compose management plugin for Cockpit",
  "author": "RXTX4816",
  "license": "MIT",
  "homepage": "https://github.com/RXTX4816/cockpit-compose",
  "repository": {
    "type": "git",
    "url": "https://github.com/RXTX4816/cockpit-compose.git"
  },
  "scripts": {
    "build": "esbuild src/index.tsx --bundle --outfile=src/main.js --minify --target=es2020 --jsx=automatic --loader:.tsx=tsx --loader:.ts=ts --loader:.svg=dataurl --external:*.woff --external:*.woff2 --external:*.ttf --external:*.eot --external:*.png --external:*.jpg --external:*.gif",
    "watch": "esbuild src/index.tsx --bundle --outfile=src/main.js --target=es2020 --jsx=automatic --loader:.tsx=tsx --loader:.ts=ts --loader:.svg=dataurl --external:*.woff --external:*.woff2 --external:*.ttf --external:*.eot --external:*.png --external:*.jpg --external:*.gif --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@patternfly/react-core": "^6.4.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitest/coverage-v8": "^4.1.6",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^5.7.2",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "cockpit",
    "docker",
    "docker-compose",
    "container",
    "management"
  ],
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@types/js-yaml": "^4.0.9",
    "ajv": "^8.20.0",
    "codemirror": "^6.0.2",
    "js-yaml": "^4.1.1"
  }
}
